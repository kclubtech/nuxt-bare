# Authentication (required in production; generated automatically in dev)
# Signing key for user session cookies (nuxt-auth-utils).
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=your-super-secret-session-key-here

# Application
NUXT_APP_NAME=Nuxt App
NUXT_APP_URL=http://localhost:3000
# Public site URL used for canonical links and og:image (set to your production domain, e.g. https://example.com)
NUXT_PUBLIC_SITE_URL=

# Email Configuration (nodemailer)
NUXT_MAIL_HOST=smtp.gmail.com
NUXT_MAIL_PORT=587
NUXT_MAIL_USER=your-email@gmail.com
NUXT_MAIL_PASS=your-app-password
NUXT_MAIL_FROM=noreply@example.com
NUXT_MAIL_SECURE=false # true for port 465 (SMTPS)

# Database (SQLite - no additional config needed)
# Database file is automatically created at ./database.db

# Development
NODE_ENV=development
NITRO_PORT=3000
NUXT_OG_IMAGE_SECRET=0bba28d18e8aa2b50f9e8b4f12fa5b62567461a85c921318bc53723abff9b476
