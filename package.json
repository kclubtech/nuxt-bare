{
  "name": "nuxt-bare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "typecheck": "nuxt typecheck",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts --force",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:up": "drizzle-kit up --config=drizzle.config.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "rm -f database.db && pnpm db:push && pnpm db:seed"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.4",
    "@nuxt/test-utils": "4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@nuxtjs/seo": "5.3.12",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "1.0.2",
    "@pinia/nuxt": "1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@takumi-rs/core": "^2.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/vue-3": "^3.30.1",
    "@types/nodemailer": "^8.0.1",
    "@vueuse/nuxt": "^14.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "evlog": "2.26.0",
    "fontless": "^0.2.1",
    "nitropack": "^2.13.4",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-email-renderer": "^2.11.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "unifont": "^0.7.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@adonisjs/hash": "^10.1.1",
    "@faker-js/faker": "^10.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.29.3"
}
